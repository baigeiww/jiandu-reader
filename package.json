{
  "name": "arxiv-reader-demo",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "scripts": {
    "desktop": "open ./笺读.app",
    "desktop:build": "npm run build && native/build.zsh",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node server/build.mjs",
    "test:mac": "npm run build && node tests/mac/run.mjs",
    "test": "tsx --test src/core.test.ts src/frontiers.test.ts src/translationTasks.test.ts src/readerDom.test.ts src/librarySummary.test.ts assistant-server.test.ts local-deepseek.test.ts server/app.test.ts",
    "desktop:release": "npm run build && native/release.zsh"
  },
  "dependencies": {
    "dompurify": "^3.2.0",
    "katex": "^0.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^26.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  }
}
